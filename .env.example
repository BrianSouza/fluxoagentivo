# Copy to .env and adjust as needed. Never commit real secrets.

APP_ENVIRONMENT=development

# PostgreSQL (pgvector)
POSTGRES_DSN=postgresql+psycopg://harness:harness@localhost:5432/harness

# Redis
REDIS_URL=redis://localhost:6379/0

# Object store (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=harness
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

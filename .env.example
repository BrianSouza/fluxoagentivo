# Copy to .env and adjust as needed. Never commit real secrets.

APP_ENVIRONMENT=development

# PostgreSQL (pgvector)
POSTGRES_DSN=postgresql+psycopg://harness:harness@localhost:5432/harness

# Redis
REDIS_URL=redis://localhost:6379/0

# Object store (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=harness
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Connector credentials, resolved from `secret://<scope>/<name>` references.
# The database stores only the reference, never these values.
# secret://confluence/main resolves to the SECRET_CONFLUENCE_MAIN_* pairs:
# SECRET_CONFLUENCE_MAIN_EMAIL=bot@example.com
# SECRET_CONFLUENCE_MAIN_TOKEN=replace-me
